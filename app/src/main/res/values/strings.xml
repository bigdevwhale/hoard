    <!-- Onboarding -->
    <string name="onb_title">You are a dragon</string>
    <string name="onb_text">And a dragon keeps a hoard. Yours is made of moments: every day you carry a few of them into your cave, and they turn into treasure.</string>
    <string name="onb_coin">A photo becomes a coin, the moment struck in metal.</string>
    <string name="onb_gem">Something special becomes a gem.</string>
    <string name="onb_relic">A milestone becomes a relic: a crown, a sword, a key.</string>
    <string name="onb_mirror">A clip becomes a mirror that comes alive.</string>
    <string name="onb_name_title">Name your dragon</string>
    <string name="onb_name_text">It sleeps on your hoard, grows with it, and now and then rolls an old treasure out to you.</string>
    <string name="onb_name_hint">Its name</string>
    <string name="onb_rules_title">The forge</string>
    <string name="onb_rules_text">A few moments a day, no more: that makes you choose what\'s worth keeping. And what goes into the forge cools overnight. You\'ll see your treasures in the morning.</string>
    <string name="onb_start">Light the forge</string>

